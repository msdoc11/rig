# Образец .env: скопируйте в .env и заполните. Настоящие переменные окружения сервера важнее файла.
APP_NAME=rig
APP_URL=http://127.0.0.1:8000
# ключ подписи; без него rig создаст storage/app.key
# APP_KEY=

# --- база данных: pgsql | mysql | sqlite
DB_CONNECTION=pgsql
# true — rig dev сам создаёт и запускает PostgreSQL проекта (storage/postgres). На продакшене — false.
DB_MANAGED=true
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=rig
DB_USERNAME=rig
DB_PASSWORD=
# PG_BIN=D:/OSPanel/modules/PostgreSQL-18/bin

# --- почта: log (в storage/logs/mail.log) | smtp
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
# tls (STARTTLS) | ssl | none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=${APP_NAME}

# --- журнал: debug | info | warning | error
LOG_LEVEL=debug
